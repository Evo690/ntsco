+  left: 50%;
+  transform: translateX(-50%) translateY(-60px);
+  z-index: 1200;
+  pointer-events: none;
+  background: var(--accent);
+  color: white;
+  border-radius: 999px;
+  padding: 8px 18px;
+  font-size: 13px;
+  font-weight: 700;
+  transition: transform .24s ease
+}
+
+.chem-feedback-flash.show {
+  transform: translateX(-50%) translateY(0)
+}
+
+.chem-feedback-flash.wrong {
+  background: #ef4444
+}
+
+.chem-stats-sheet {
+  display: none;
+  position: fixed;
+  inset: 0;
+  z-index: 1100;
+  align-items: flex-end;
+  justify-content: center;
+  background: rgba(0, 0, 0, .56)
+}
+
+.chem-stats-sheet.open {
+  display: flex
+}
+
+.chem-stats-panel {
+  width: min(520px, 100%);
+  background: var(--bg2);
+  border: 1px solid var(--border);
+  border-radius: 18px 18px 0 0;
+  padding: 18px
+}
+
+.chem-stats-title {
+  color: var(--text);
+  font-size: 16px;
+  font-weight: 700;
+  margin-bottom: 12px
+}
+
+.chem-stat-row {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 12px;
+  padding: 10px 0;
+  border-bottom: 1px solid var(--border)
+}
+
+.chem-stat-row:last-child {
+  border-bottom: 0
+}
+
+.chem-stat-name {
+  color: var(--text2);
+  font-size: 13px
+}
+
+.chem-stat-val {
+  color: var(--text3);
+  font-family: 'Space Mono', monospace;
+  font-size: 11px
+}
+
+.chem-hidden {
+  display: none
+}
+
+.chem-board-head {
+  display: flex;
+  align-items: flex-start;
+  justify-content: space-between;
+  gap: 12px;
+  margin-bottom: 12px
+}
+
+.chem-board-sub {
+  font-size: 12px;
+  color: var(--text3);
+  margin-top: -5px
+}
+
+.chem-board-tabs {
+  display: flex;
+  gap: 6px;
+  background: var(--bg3);
+  border: 1px solid var(--border);
+  border-radius: 10px;
+  padding: 4px
+}
+
+.chem-tab-btn {
+  border: 0;
+  border-radius: 7px;
+  background: transparent;
+  color: var(--text3);
+  font-size: 12px;
+  font-weight: 700;
+  padding: 7px 10px;
+  cursor: pointer
+}
+
+.chem-tab-btn.active {
+  background: var(--accent);
+  color: var(--accent-text);
+}
+
+.chem-board-list {
+  display: flex;
+  flex-direction: column;
+  gap: 8px
+}
+
+.chem-board-row {
+  display: grid;
+  grid-template-columns: 38px 1fr auto;
+  align-items: center;
+  gap: 10px;
+  background: var(--bg3);
+  border: 1px solid var(--border);
+  border-radius: 10px;
+  padding: 10px 12px
+}
+
+.chem-board-rank {
+  font-family: 'Space Mono', monospace;
+  color: var(--accent);
+  font-size: 12px;
+  font-weight: 700
+}
+
+.chem-board-name {
+  min-width: 0;
+  color: var(--text);
+  font-size: 13px;
+  font-weight: 700;
+  white-space: nowrap;
+  overflow: hidden;
+  text-overflow: ellipsis
+}
+
+.chem-board-score {
+  font-family: 'Space Mono', monospace;
+  color: var(--text3);
+  font-size: 11px;
+  text-align: right
+}
+
+@media (max-width:700px) {
+  .chem-header {
+    align-items: flex-start;
+    flex-direction: column
+  }
+
+  .chem-stat-bar {
+    justify-content: flex-start
+  }
+
+  .chem-board-head {
+    flex-direction: column
+  }
+
+  .chem-menu-grid,
+  .chem-options-grid {
+    grid-template-columns: 1fr
+  }
+
+  .chem-full-width {
+    grid-column: auto
+  }
+
+  .chem-canvas-wrap {
+    min-height: 220px
+  }
+}
+
diff --git a/src/styles/legacy/foundation.css b/src/styles/legacy/foundation.css
new file mode 100644
