+.terminal-dots i:first-child { background: #8b5655; }.terminal-dots i:nth-child(2) { background: #92804c; }.terminal-dots i:last-child { background: #6f8859; }
+.console-titlebar code { font-size: 11px; color: #9aa7aa; }
