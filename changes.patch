+.square-dot { width: 5px; height: 5px; background: var(--accent); display: inline-block; flex-shrink: 0; }
+.heading-dot { color: var(--accent); }
+.utility-button { display: inline-flex; align-items: center; justify-content: center; gap: 22px; padding: 10px 14px; border: 1px solid var(--border2); background: var(--bg3); color: var(--text); font: 11px var(--font-mono); border-radius: 3px; cursor: pointer; }
