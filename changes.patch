+.record-open { padding: 10px 13px; min-height: 38px; border: 1px solid var(--border2); border-radius: 3px; color: var(--text); background: var(--bg); font: 10px var(--font-mono); white-space: nowrap; cursor: pointer; }
+.record-open span { margin-left: 12px; color: var(--accent); }.record-open:hover { border-color: var(--accent); }
+.record-open:disabled { opacity: .5; cursor: not-allowed; }
+
+/* Timetables, exams, resources and messages are record lists, not hero cards. */
