+}
+
+.pl-meta-tag {
+  color: var(--text3);
+  font-size: 11px;
+  font-weight: 600;
+  text-transform: uppercase;
+  letter-spacing: 0.04em;
+}
+
+.pl-meta-model {
+  color: var(--text);
+  font-family: 'Space Mono', monospace;
+  font-size: 12px;
+}
+
+.pl-meta-right {
+  display: flex;
+  align-items: center;
+  gap: 6px;
+  font-family: 'Space Mono', monospace;
+  font-size: 12px;
+}
+
+.pl-latency-label {
+  color: var(--text3);
+}
+
+.pl-latency-val {
+  color: var(--accent);
+  font-weight: 700;
+}
+
+/* Subtabs for Neural page */
+#page-neural[data-subview="leaderboard"] #card-ranknet-predictor {
