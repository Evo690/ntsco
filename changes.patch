+/* Light mode */
+body.light-mode {
+  --bg: #fafafa;
+  --bg2: #ffffff;
+  --bg3: #f5f5f5;
+  --bg4: #ebebeb;
+  --border: #e5e5e5;
+  --border2: #d4d4d4;
+  --text: #0a0a0a;
+  --text2: #525252;
+  --text3: #a3a3a3;
+  --accent: #000;
+  --accent2: #333;
+  --accent-text: #ffffff;
+  --accent-glow: rgba(0, 0, 0, 0.08);
+}
+
+body.light-mode {
+  background: var(--bg);
+}
+
+body.light-mode .login-card {
+  background: var(--bg2);
+  border: 1px solid var(--border);
+  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.06);
+}
+
+body.light-mode .login-input {
+  background: var(--bg3);
+}
+
+body.light-mode .login-input::placeholder {
+  color: var(--text3);
+}
+
+body.light-mode #login-screen {
+  background: var(--bg);
+}
+
+body.light-mode .sidebar {
+  background: var(--bg2);
+}
+
+body.light-mode .topbar {
+  background: var(--bg2);
+}
+
+body.light-mode .dashboard-hero {
+  background: var(--bg2);
+}
+
+body.light-mode .stat-card,
+body.light-mode .card,
+body.light-mode .full-card,
+body.light-mode .msg-sidebar,
+body.light-mode .msg-content,
+body.light-mode .course-card,
+body.light-mode .exam-hall-item,
+body.light-mode .notice-item,
+body.light-mode .msg-group-item,
+body.light-mode .msg-bubble {
+  background: #ffffff;
+}
+
+body.light-mode .hero-btn.ghost {
+  background: var(--bg3);
+  color: var(--text2);
+}
+
+body.light-mode .topbar-search,
+body.light-mode .topbar-btn {
+  background: var(--bg3);
+}
+
+body.light-mode .subnav {
+  background: transparent;
+}
+
+body.light-mode .subnav-chip {
+  background: var(--bg3);
+  border-color: var(--border);
+  color: var(--text2);
+}
+
+body.light-mode .subnav-chip.active {
+  background: var(--accent);
+  border-color: transparent;
+  color: var(--accent-text);
+}
+
+body.light-mode .dock-btn.active {
+  color: var(--accent);
+  background: var(--accent-glow);
+}
+
+body.light-mode .mobile-dock {
+  background: var(--bg2);
+}
+
+body.light-mode .exam-calendar-chip {
+  background: var(--bg3);
+  border-color: var(--border);
+  color: var(--text2);
+}
+
+body.light-mode .exam-calendar-chip.subtle {
+  color: var(--text3);
+}
+
+/* Theme presets (dark mode palettes) */
+body.theme-ocean {
+  --accent: #4f9dff;
+  --accent2: #20b6ff;
+  --accent-text: #ffffff;
+  --accent-glow: rgba(79, 157, 255, 0.12);
+}
+
+body.theme-purple {
+  --accent: #9b7bff;
+  --accent2: #c25dff;
+  --accent-text: #ffffff;
+  --accent-glow: rgba(155, 123, 255, 0.12);
+}
+
+body.theme-emerald {
+  --accent: #22c55e;
+  --accent2: #14b8a6;
+  --accent-text: #ffffff;
+  --accent-glow: rgba(34, 197, 94, 0.10);
+}
+
+
+
+/* Final unified action-button system */
+body .start-btn,
+body .class-btn,
+body .course-btn,
+body .hero-btn,
+body .exam-view-btn,
+body #page-dashboard .stat-card button,
+body .theme-mode-btn,
+body .login-btn,
+body .chem-btn-primary,
+body button.start-btn {
+  display: inline-flex !important;
+  align-items: center !important;
+  justify-content: center !important;
+  gap: 6px !important;
+  border-radius: var(--r, 8px) !important;
+  padding: 8px 14px !important;
+  font-size: 12px !important;
+  font-weight: 600 !important;
+  line-height: 1.2 !important;
+  background: var(--accent) !important;
+  color: var(--accent-text) !important;
+  border: 1px solid transparent !important;
+  box-shadow: none !important;
+  text-shadow: none !important;
+  cursor: pointer !important;
+  transition: opacity 0.15s ease, background 0.15s ease !important;
+}
+
+body .start-btn.gray,
+body .class-btn.gray,
+body .hero-btn.ghost,
+body button.start-btn.gray {
+  background: var(--bg3) !important;
+  color: var(--text2) !important;
+  border: 1px solid var(--border) !important;
+}
+
+body .start-btn.gray:hover:not(:disabled),
+body .class-btn.gray:hover:not(:disabled),
+body .hero-btn.ghost:hover:not(:disabled),
+body button.start-btn.gray:hover:not(:disabled) {
+  background: var(--bg4) !important;
+  color: var(--text) !important;
+  border-color: var(--border2) !important;
+}
+
+body .start-btn:hover:not(:disabled),
+body .class-btn:hover:not(:disabled),
+body .hero-btn:hover:not(:disabled),
+body .login-btn:hover:not(:disabled),
+body .chem-btn-primary:hover:not(:disabled) {
+  opacity: 0.9 !important;
+}
+
+body .start-btn:disabled,
+body .start-btn.gray:disabled,
+body .class-btn:disabled,
+body .class-btn.gray:disabled,
+body .course-btn:disabled,
+body .hero-btn:disabled,
+body .hero-btn.ghost:disabled,
+body .exam-view-btn:disabled,
+body #page-dashboard .stat-card button:disabled {
+  opacity: 0.55 !important;
+  cursor: not-allowed !important;
+  box-shadow: none !important;
+}
+
+body.light-mode .app,
+body.light-mode .dashboard-hero,
+body.light-mode .sidebar,
+body.light-mode .topbar,
+body.light-mode .stat-card,
+body.light-mode .card,
+body.light-mode .full-card {
+  box-shadow: none;
+}
+
+@media(max-width:768px) {
+  body #page-courses .card-header {
+    margin-bottom: 4px;
+  }
+
+  body #courses-grid.three-col {
+    display: flex;
+    flex-direction: column;
+    gap: 12px;
+  }
+
+  body #page-courses .course-card {
+    background:
+      linear-gradient(90deg, color-mix(in srgb, var(--course-tone, var(--accent)) 14%, transparent), transparent 48%),
+      linear-gradient(165deg, rgba(18, 27, 49, 0.94), rgba(12, 18, 34, 0.94)) !important;
+    border-color: color-mix(in srgb, var(--course-tone, var(--accent)) 32%, var(--border)) !important;
+    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.18) !important;
+    transform: none !important;
+  }
+
+  body.light-mode #page-courses .course-card {
+    background:
+      linear-gradient(90deg, color-mix(in srgb, var(--course-tone, var(--accent)) 10%, transparent), transparent 48%),
+      #ffffff !important;
+    box-shadow: 0 8px 18px rgba(15, 25, 60, 0.08) !important;
+  }
+
+  body #page-courses .course-image {
+    box-shadow: 0 6px 14px rgba(0, 0, 0, 0.18);
+  }
+
+  body #page-courses .course-bottom {
+    margin-top: 1px;
+  }
+
+  body #page-courses .course-btn {
+    min-height: 34px !important;
+    min-width: 72px !important;
+    padding: 8px 12px !important;
+    border-radius: 9px !important;
+    flex-shrink: 0;
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+
+  .page,
+  .card,
+  .full-card,
+  .stat-card,
+  .course-card,
+  .exam-hall-item,
+  .notice-item,
+  .msg-group-item {
+    animation: none !important;
+    transition: none !important;
+  }
+
+  .skeleton::after {
+    animation: none !important
+  }
+}
+
diff --git a/src/styles/legacy/leaderboard.css b/src/styles/legacy/leaderboard.css
