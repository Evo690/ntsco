+.settings-tool-link { display: grid; grid-template-columns: 22px minmax(0,1fr) auto 12px; align-items: start; gap: 12px; padding: 22px; border-bottom: 1px solid var(--border); color: var(--text); text-decoration: none; }
+.settings-tool-link:nth-child(odd) { border-right: 1px solid var(--border); }
+.settings-tool-link:hover { background: var(--accent-glow); }.settings-tool-link:focus-visible { outline: 2px solid var(--accent); outline-offset: -2px; }
+.settings-tool-code { color: var(--accent); font: 10px/1.8 var(--font-mono); }
+.settings-tool-link strong { font: 500 14px/1.5 var(--font-body); }.settings-tool-link small { display: block; color: var(--text3); font: 11px/1.8 var(--font-body); margin-top: 6px; }
+.settings-tool-link > code { color: var(--text3); font: 8px/1.8 var(--font-mono); padding-top: 3px; }
+.settings-tool-link > span:last-child { color: var(--accent); }
+.settings-quick-launches { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); }
+.settings-quick-launch { padding: 24px; min-width: 0; }.settings-quick-launch:first-child { border-right: 1px solid var(--border); }
+.settings-quick-launch > code { color: var(--text3); font: 9px var(--font-mono); }
+.settings-quick-launch h3 { font: 500 17px var(--font-body); margin-top: 12px; }
