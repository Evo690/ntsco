+.recording-console-header > div { min-width: 0; }.recording-console-header code { color: var(--accent); font: 10px var(--font-mono); overflow-wrap: anywhere; }.recording-console-header h2 { font: 500 23px var(--font-body); margin: 10px 0 8px; }.recording-console-header p { color: var(--text3); font: 10px/1.8 var(--font-mono); }
+.recording-console-actions { display: flex; gap: 8px; flex-wrap: wrap; padding: 12px 22px; }
