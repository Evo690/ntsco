+body.portal .class-item { min-width: 0; }
+body.portal .class-time { flex: 0 0 70px; font: 11px var(--font-mono); color: var(--text2); }
+body.portal .class-info { min-width: 0; }
+body.portal .class-name { font-size: 13px; overflow-wrap: anywhere; }
+body.portal .class-teacher { margin-top: 5px; color: var(--text3); }
+body.portal .workspace-footer .text-button { color: var(--text2); }
+
+/* Course records deliberately do not reuse .course-card: the old mobile card
