+}
+
+.chem-canvas-wrap {
+  min-height: 260px;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  background: var(--bg3);
+  border: 1px solid var(--border);
+  border-radius: 12px;
+  overflow: hidden
+}
+
+.chem-canvas-wrap canvas {
+  max-width: 100%;
+  height: auto;
+  display: block
+}
+
+.chem-compound-name {
+  margin-top: 14px;
+  text-align: center;
+  font-size: 22px;
+  font-weight: 700;
+  color: var(--text)
+}
+
+.chem-compound-meta {
+  display: flex;
+  justify-content: center;
+  flex-wrap: wrap;
+  gap: 14px;
+  margin-top: 8px;
+  font-family: 'Space Mono', monospace;
+  font-size: 11px;
+  color: var(--text3)
+}
+
+.chem-compound-meta span {
+  display: inline-flex;
+  align-items: center;
+  gap: 5px
+}
+
+.chem-meta-dot {
+  width: 7px;
+  height: 7px;
+  border-radius: 50%;
+  display: inline-block
+}
+
+.chem-dot-green {
+  background: #22c55e
+}
+
+.chem-dot-red {
+  background: #ef4444
+}
+
+.chem-dot-amber {
+  background: #f59e0b
+}
+
+.chem-learn-nav {
+  display: grid;
+  grid-template-columns: 1fr auto 1fr;
+  align-items: center;
+  gap: 10px
+}
+
+.chem-nav-counter {
+  min-width: 64px;
+  text-align: center;
+  font-family: 'Space Mono', monospace;
+  font-size: 12px;
+  color: var(--text3)
+}
+
+.chem-question-hint {
+  margin-top: 12px;
+  text-align: center;
+  font-family: 'Space Mono', monospace;
+  font-size: 12px;
+  color: var(--text3)
+}
+
+.chem-options-grid {
+  display: grid;
+  grid-template-columns: 1fr 1fr;
+  gap: 10px
+}
+
+.chem-opt-btn {
+  display: flex;
+  align-items: center;
+  gap: 10px;
+  min-height: 54px;
+  padding: 12px 14px;
