+}
+
+.command-meta {
+  font-size: 11px;
+  color: var(--text3)
+}
+
+/* Virtualized list helpers */
+.virtual-list {
+  position: relative;
+  overflow-y: auto;
+}
+
+.virtual-spacer {
+  width: 100%;
+}
+
+.virtual-content {
+  position: absolute;
+  top: 0;
+  left: 0;
+  right: 0;
+}
