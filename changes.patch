+  const tokens = [];
+  const seen = new Set();
+
+  const addToken = str => {
+    if (!str) return;
+    String(str)
+      .split(/[,;|•·\n]+/)
+      .map(s => s.trim())
+      .filter(Boolean)
+      .forEach(t => {
+        const lower = t.toLowerCase();
+        if (!seen.has(lower)) {
+          seen.add(lower);
+          tokens.push(t);
+        }
+      });
+  };
