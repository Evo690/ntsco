+.settings-appearance .theme-preset-btn { min-height: 76px; text-align: left; }
+.setting-action-row { display: flex; align-items: center; justify-content: space-between; gap: 20px; padding: 20px 24px; border-bottom: 1px solid var(--border); }
+.setting-action-row:last-child { border-bottom: 0; }
