+.recording-screen-state code { color: var(--red); font: 9px var(--font-mono); }
+.recording-loader { width: 26px; height: 26px; border: 2px solid var(--border); border-top-color: var(--accent); border-radius: 50%; animation: spin .8s linear infinite; }
+.recording-console-footer { display: flex; flex-wrap: wrap; align-items: center; gap: 18px; padding: 18px 22px; border-top: 1px solid var(--border); }
+.recording-speeds { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; }.recording-speeds > span { font: 9px var(--font-mono); color: var(--text3); margin-right: 5px; }
+.player-speed-btn,.recent-id-chip { background: var(--bg); border: 1px solid var(--border2); border-radius: 3px; color: var(--text2); font: 10px var(--font-mono); padding: 8px; cursor: pointer; }.player-speed-btn.active { color: var(--accent); border-color: var(--accent); background: var(--accent-glow); }
