+.tool-breadcrumb { display: flex; align-items: center; gap: 13px; font: 10px var(--font-mono); color: var(--text3); }.tool-breadcrumb code { color: var(--text2); }.tool-breadcrumb > span { color: var(--border2); }
+.tool-chrome-actions { margin-left: auto; display: flex; gap: 15px; align-items: center; }
+.workspace-link { font: 10px var(--font-mono); color: var(--text2); }.workspace-link:hover { color: var(--accent); }
