+
+.chem-btn {
+  min-height: 42px;
+  border: 0;
+  border-radius: 10px;
+  padding: 10px 14px;
+  font-family: 'DM Sans', sans-serif;
+  font-size: 13px;
+  font-weight: 600;
+  cursor: pointer;
+  transition: transform .14s ease, background .14s ease, border-color .14s ease
+}
+
+.chem-btn:active {
