+  justify-content: space-between;
+  align-items: center;
+  flex-wrap: wrap;
+  gap: 8px;
+  margin-bottom: 12px;
+}
+
+.sol-card-title {
+  font-weight: 700;
+  font-size: 14px;
+  color: var(--text);
+}
+
+.sol-card-badges {
+  display: flex;
+  gap: 6px;
+  align-items: center;
+}
+
+.sol-badge {
+  font-size: 11px;
+  font-weight: 600;
+  padding: 3px 8px;
+  border-radius: 6px;
+}
+
+.sol-badge.easy {
+  background: rgba(34, 197, 94, 0.12);
+  color: var(--green);
+}
+
+.sol-badge.medium {
+  background: rgba(245, 158, 11, 0.12);
