+  padding: 8px;
+  display: flex;
+  flex-direction: column;
+  gap: 6px;
+}
+
+.command-item {
+  border: 1px solid rgba(123, 150, 218, 0.2);
+  border-radius: 10px;
+  background: rgba(22, 33, 58, 0.58);
+  color: var(--text2);
