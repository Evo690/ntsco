+}
+
+.chem-btn-primary {
+  color: var(--accent-text);
+  background: var(--accent);
+  box-shadow: none
+}
+
+.chem-btn-secondary {
+  color: var(--text);
+  background: var(--bg3);
+  border: 1px solid var(--border)
+}
+
+.chem-btn-ghost {
+  color: var(--text2);
+  background: transparent;
+  border: 1px solid var(--border)
+}
+
+.chem-btn-secondary:hover,
+.chem-btn-ghost:hover {
+  background: var(--bg4);
+  color: var(--text)
+}
+
+.chem-wide-btn {
+  width: 100%;
+  margin-top: 2px
+}
+
+.chem-progress-track {
+  height: 4px;
+  background: var(--bg4);
+  border-radius: 999px;
+  overflow: hidden;
+  margin-bottom: 14px
+}
+
+.chem-progress-fill {
+  height: 100%;
+  width: 0;
+  background: linear-gradient(90deg, var(--accent), var(--accent2));
