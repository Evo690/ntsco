+  border-color: var(--border2);
+}
+
+.sol-card.correct-card {
+  border-left: 4px solid var(--green);
+}
+
+.sol-card.incorrect-card {
+  border-left: 4px solid var(--red);
+}
+
+.sol-card.skipped-card {
+  border-left: 4px solid var(--text3);
+}
+
+.sol-card-header {
