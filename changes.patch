+.lab-console { background: var(--bg2); border: 1px solid var(--border); border-radius: 4px; overflow: hidden; }
+.lab-console-title { display: flex; justify-content: space-between; align-items: center; gap: 20px; padding: 23px 26px; border-bottom: 1px solid var(--border); background: var(--bg3); }
+.lab-console-title code { color: var(--signal-violet); font: 9px var(--font-mono); letter-spacing: 1px; }.lab-console-title h2 { color: var(--text); font: 500 25px/1.5 var(--font-body); letter-spacing: -.6px; margin-top: 8px; }
+.lab-workspace { display: grid; grid-template-columns: minmax(320px,.85fr) minmax(0,1.25fr); }
+.lab-input-pane { min-width: 0; padding: 24px; border-right: 1px solid var(--border); }.lab-output-pane { min-width: 0; padding: 24px; }
+.lab-section-caption { display: flex; justify-content: space-between; gap: 12px; color: var(--text3); font: 9px/1.8 var(--font-mono); letter-spacing: .5px; margin-bottom: 22px; }.lab-section-caption > span { text-align: right; }
