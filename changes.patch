+}
+/* Player is a body-level dialog; it must not inherit a hidden practice sheet. */
+.recording-console-overlay { position: fixed; inset: 0; z-index: 10000; padding: 24px; background: #050709d9; backdrop-filter: blur(6px); display: flex; align-items: center; justify-content: center; transition: opacity .2s; }
