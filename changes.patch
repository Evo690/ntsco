+/* Shared utility workbench. Loaded after each tool's structural compatibility stylesheet. */
+body.tool-page { margin: 0; padding: 0; display: flex; flex-direction: column; height: 100dvh; width: 100%; min-width: 0; overflow: hidden; background: var(--bg); color: var(--text); font-family: var(--font-body); }
