+  --bg: #0d0f11; --bg2: #131618; --bg3: #1a1e21; --border: #292f32; --border2: #404b50; --text: #e3e8e7; --text2: #9ca8ac; --text3: #7f8d91; --accent: #c3f779; --accent-text: #15200b;
+}
