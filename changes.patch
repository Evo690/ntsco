+.settings-operation-status[data-state="success"] { color: var(--accent); }.settings-operation-status[data-state="error"] { color: var(--red); }
+.settings-toolkit-heading { display: flex; justify-content: space-between; gap: 20px; align-items: center; padding: 24px; }
