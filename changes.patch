+/* Feature surfaces. Kept separate from shell layout and the compatibility CSS.
+   Dynamic renderers use these records too; styling is not limited to empty pages. */
+
+/* The daily schedule is the primary dashboard content. */
+body.portal #dash-streams { grid-template-columns: minmax(0, 1.5fr) minmax(250px, 1fr); margin-top: 20px; }
+body.portal #dash-streams > .card { min-width: 0; }
