+  font-size: 13px;
+  font-weight: 600;
+  cursor: pointer
+}
+
+.chem-opt-btn:hover:not(:disabled) {
+  background: var(--bg3);
+  border-color: rgba(61, 127, 255, .45)
+}
+
+.chem-opt-letter {
+  width: 26px;
+  height: 26px;
+  border-radius: 7px;
+  flex-shrink: 0;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  background: var(--bg4);
+  color: var(--text3);
