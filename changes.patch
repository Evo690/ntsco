+body.theme-purple { --accent: #c4afff; --accent2: #deceff; --accent-glow: #c4afff0d; }
+body.theme-emerald { --accent: #7ae4aa; --accent2: #b3f9d1; --accent-glow: #7ae4aa0d; }
+body.light-mode.theme-ocean { --accent: #126c81; --accent2: #075365; --accent-glow: #126c810d; }
