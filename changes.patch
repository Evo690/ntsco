+.enrollment-cover img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; background: var(--bg); }
+.enrollment-record { min-width: 0; }
+.record-kicker { display: flex; flex-wrap: wrap; gap: 12px; color: var(--text3); font: 9px var(--font-mono); margin-bottom: 10px; }
