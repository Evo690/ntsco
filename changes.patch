diff --git a/src/styles/legacy/practice.css b/src/styles/legacy/practice.css
new file mode 100644
index 0000000..0f97a69
--- /dev/null
+++ b/src/styles/legacy/practice.css
@@ -0,0 +1,321 @@
+/* Chemistry Practice Structure & Text Input Styles */
+.chem-opt-btn-structure {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  justify-content: center;
+  padding: 16px;
+  background: var(--bg2);
+  border: 1px solid var(--border);
+  border-radius: 12px;
+  cursor: pointer;
+  width: 100%;
+  aspect-ratio: 1.4;
+  min-height: 160px;
+  position: relative;
+  transition: all 0.2s ease;
+}
+
+.chem-opt-btn-structure:hover:not(:disabled) {
+  background: var(--bg3);
+  border-color: rgba(61, 127, 255, 0.45);
+}
+
+.chem-opt-btn-structure.correct {
+  background: rgba(34, 197, 94, 0.12);
+  border-color: #22c55e;
+}
+
+.chem-opt-btn-structure.wrong {
+  background: rgba(239, 68, 68, 0.12);
+  border-color: #ef4444;
+}
+
+.chem-opt-btn-structure.reveal {
+  border-color: #22c55e;
+  opacity: 0.8;
+}
+
+.chem-opt-btn-structure canvas {
+  max-width: 100%;
+  max-height: 100%;
+  object-fit: contain;
+}
+
+.chem-options-grid.chem-reverse-layout {
+  grid-template-columns: 1fr 1fr;
+  gap: 12px;
+}
+
+@media (max-width: 700px) {
+  .chem-options-grid.chem-reverse-layout {
+    grid-template-columns: 1fr;
+  }
+}
+
+/* Switch Toggle Custom Styling */
+.switch {
+  position: relative;
+  display: inline-block;
+  width: 44px;
+  height: 24px;
+  flex-shrink: 0;
+}
+
+.switch input {
+  opacity: 0;
+  width: 0;
+  height: 0;
+}
+
+.switch-slider {
+  position: absolute;
+  cursor: pointer;
+  inset: 0;
+  background-color: var(--border);
+  border-radius: 24px;
+  transition: 0.3s;
+}
+
+.switch-slider:before {
+  position: absolute;
+  content: "";
+  height: 16px;
+  width: 16px;
+  left: 4px;
+  bottom: 4px;
+  background-color: var(--text3);
+  border-radius: 50%;
+  transition: 0.3s;
+}
+
+.switch input:checked+.switch-slider {
+  background-color: var(--accent);
+}
+
+.switch input:checked+.switch-slider:before {
+  transform: translateX(20px);
+  background-color: #0a0a0a;
+}
+
+/* RDKit Canvas dark/light mode rendering filters */
+.rdkit-canvas {
+  background-color: #121b31;
+  filter: invert(1) hue-rotate(180deg);
+  transition: filter 0.15s ease, background-color 0.15s ease;
+}
+
+body.light-mode .rdkit-canvas {
+  background-color: #ffffff;
+  filter: none;
+}
+
+/* Practice Mode Selection styles */
+.mode-cards-grid {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
+  gap: 20px;
+  margin-top: 10px;
+}
+
+.mode-card {
+  background: var(--bg2);
+  border: 1px solid var(--border);
+  border-radius: 16px;
+  padding: 24px;
+  cursor: pointer;
+  transition: transform 0.22s cubic-bezier(0.25, 0.8, 0.25, 1), border-color 0.22s ease, box-shadow 0.22s ease;
+  will-change: transform, box-shadow;
+  text-align: left;
+  display: flex;
+  flex-direction: column;
+  justify-content: space-between;
+  min-height: 240px;
+  position: relative;
+}
+
+.mode-card:hover {
+  transform: translateY(-4px);
+  border-color: var(--accent) !important;
+  box-shadow: 0 12px 30px var(--accent-glow) !important;
+}
+
+.mode-card-content {
+  display: flex;
+  flex-direction: column;
+  gap: 12px;
+}
+
+.mode-card-icon {
+  font-size: 32px;
+}
+
+.mode-card-title {
+  font-size: 18px;
+  font-weight: 700;
+  color: var(--text);
+  margin-bottom: 8px;
+}
+
+.mode-card-desc {
+  font-size: 13px;
