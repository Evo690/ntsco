+body.portal #courses-grid { grid-template-columns: minmax(0, 1fr); gap: 10px; }
+.enrollment-card { display: grid; grid-template-columns: 68px minmax(0, 1fr) auto; align-items: center; gap: 22px; padding: 22px; background: var(--bg2); border: 1px solid var(--border); border-radius: 4px; }
