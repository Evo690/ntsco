+}
+
+.ak-qno {
+  font-size: 9px;
+  font-weight: 600;
+  color: var(--text3);
+  letter-spacing: 0.04em;
+}
+
+.ak-ans {
+  font-family: 'Space Mono', monospace;
+  font-size: 14px;
+  font-weight: 700;
+  color: var(--text);
+}
+
+.ak-cell.ak-correct {
+  border-color: var(--green);
+  background: rgba(34, 197, 94, 0.08);
+}
+
+.ak-cell.ak-correct .ak-ans {
+  color: var(--green);
+}
+
+.ak-cell.ak-wrong {
+  border-color: var(--red);
+  background: rgba(239, 68, 68, 0.08);
+}
+
+.ak-cell.ak-wrong .ak-ans {
+  color: var(--red);
+}
+
+.ak-cell.ak-skipped {
+  opacity: 0.5;
+}
+
