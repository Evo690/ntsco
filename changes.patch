+  font-size: 11px
+}
+
+.chem-opt-btn.correct {
+  background: rgba(34, 197, 94, .12);
+  border-color: #22c55e;
+  color: #22c55e
+}
+
+.chem-opt-btn.correct .chem-opt-letter {
+  background: #22c55e;
+  color: #06130b
+}
+
+.chem-opt-btn.wrong {
+  background: rgba(239, 68, 68, .12);
+  border-color: #ef4444;
+  color: #ef4444
+}
+
+.chem-opt-btn.wrong .chem-opt-letter {
+  background: #ef4444;
+  color: white
+}
+
+.chem-opt-btn.reveal {
+  border-color: #22c55e;
+  color: #22c55e;
+  opacity: .8
+}
+
+.chem-feedback-flash {
+  position: fixed;
