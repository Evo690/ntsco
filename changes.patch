+.setting-action-row .console-button { flex-shrink: 0; min-width: 142px; }
+.setting-action-row :is(.switch,select) { flex-shrink: 0; }
+.settings-panel select { background: var(--bg); color: var(--text); border: 1px solid var(--border2); padding: 10px; border-radius: 3px; font: 10px var(--font-mono); }
