+}
+
+.sol-badge.time.over {
+  color: var(--amber);
+  background: rgba(245, 158, 11, 0.1);
+}
+
+.sol-badge.time.under {
+  color: var(--green);
+  background: rgba(34, 197, 94, 0.08);
+}
+
+.sol-card-body {
+  margin-bottom: 12px;
+}
+
+.sol-answers {
