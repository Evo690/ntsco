+  // Sort anchors by rank ascending, marks descending
+  anchors.sort((a, b) => a.rank - b.rank || b.marks - a.marks);
+
+  // 6. Populate inputs on Neural Network page
+  PL_STATE.batchStats = { avg, topper, maxMarks };
+  PL_STATE.anchors = anchors;
