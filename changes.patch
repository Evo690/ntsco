+.settings-disclosure { display: flex; align-items: center; justify-content: space-between; gap: 20px; width: 100%; padding: 24px; border: 0; text-align: left; background: transparent; color: var(--text); cursor: pointer; }
+.settings-disclosure strong,.settings-disclosure small { display: block; }.settings-disclosure strong { font: 500 20px var(--font-body); margin: 12px 0 8px; }.settings-disclosure small { color: var(--text3); font: 11px/1.8 var(--font-body); }
